{
  "name": "openwebqa",
  "version": "0.1.0",
  "description": "CLI that submits a markdown QA test plan to an AI agent, receives a DAG of browser test cases, validates it, and executes it with headless Playwright.",
  "bin": {
    "openwebqa": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "setup": "npm install && npm run build && npx playwright install chromium",
    "setup:deps": "npx playwright install-deps chromium",
    "build": "tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@openai/agents": "^0.19.0",
    "commander": "^12.1.0",
    "openai": "^7.2.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "eslint": "^10.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.8"
  }
}
